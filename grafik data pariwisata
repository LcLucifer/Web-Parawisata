import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import warnings
warnings.filterwarnings('ignore')

# Set style untuk visualisasi
plt.style.use('seaborn-v0_8-darkgrid')
sns.set_palette("husl")

# Membaca data dari file Excel
file_path = "wisata_indonesia_clean.xlsx"
df = pd.read_excel(file_path)

print("=" * 70)
print("ANALISIS DATA PARIWISATA INDONESIA")
print("=" * 70)
print(f"Total Data: {len(df)} objek wisata")
print(f"Kolom yang tersedia: {list(df.columns)}")
print(f"Jumlah Kategori Wisata: {df['kategori'].nunique()}")
print(f"Jumlah Provinsi: {df['provinsi'].nunique()}")

# Fungsi untuk menentukan pulau berdasarkan provinsi
def tentukan_pulau(provinsi):
    provinsi_str = str(provinsi).lower()
    
    pulau_jawa = ['jawa barat', 'jawa timur', 'jawa tengah', 'banten', 'daerah istimewa yogyakarta', 'jakarta']
    pulau_bali_nt = ['bali', 'nusa tenggara barat', 'nusa tenggara timur']
    pulau_sumatra = ['sumatera barat', 'sumatera utara', 'sumatera selatan', 'aceh', 'riau', 'jambi', 'lampung', 'kepulauan bangka belitung', 'bengkulu']
    pulau_kalimantan = ['kalimantan barat', 'kalimantan timur', 'kalimantan selatan', 'kalimantan tengah', 'kalimantan utara']
    pulau_sulawesi = ['sulawesi selatan', 'sulawesi utara', 'sulawesi tenggara', 'sulawesi tengah', 'sulawesi barat', 'gorontalo']
    pulau_maluku_papua = ['maluku', 'maluku utara', 'papua barat', 'papua', 'papua barat daya', 'papua pegunungan']
    
    for pulau_j in pulau_jawa:
        if pulau_j in provinsi_str:
            return 'Jawa'
    for pulau_b in pulau_bali_nt:
        if pulau_b in provinsi_str:
            return 'Bali & Nusa Tenggara'
    for pulau_s in pulau_sumatra:
        if pulau_s in provinsi_str:
            return 'Sumatra'
    for pulau_k in pulau_kalimantan:
        if pulau_k in provinsi_str:
            return 'Kalimantan'
    for pulau_su in pulau_sulawesi:
        if pulau_su in provinsi_str:
            return 'Sulawesi'
    for pulau_mp in pulau_maluku_papua:
        if pulau_mp in provinsi_str:
            return 'Maluku & Papua'
    
    return 'Lainnya'

df['pulau'] = df['provinsi'].apply(tentukan_pulau)

# Visualisasi distribusi per pulau
pulau_counts = df['pulau'].value_counts()

print("\n\n7. KATEGORI WISATA DOMINAN PER PULAU")

fig, axes = plt.subplots(2, 3, figsize=(18, 12))
axes = axes.flatten()

for idx, pulau in enumerate(pulau_counts.index):
    if idx < len(axes):
        pulau_data = df[df['pulau'] == pulau]
        kategori_counts_pulau = pulau_data['kategori'].value_counts().head(5)
        
        axes[idx].pie(kategori_counts_pulau.values, labels=kategori_counts_pulau.index, 
                     autopct='%1.1f%%', startangle=90)
        axes[idx].set_title(f'{pulau}\n({len(pulau_data)} objek)', fontweight='bold')

# Sembunyikan axis kosong jika ada
for idx in range(len(pulau_counts), len(axes)):
    axes[idx].set_visible(False)

plt.suptitle('Distribusi 5 Kategori Wisata Terbanyak per Pulau', fontsize=16, fontweight='bold', y=1.02)
plt.tight_layout()
plt.show()
